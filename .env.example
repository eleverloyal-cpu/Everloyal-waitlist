# Web app (copy to .env.local). VITE_ values are baked into the public browser bundle,
# so never put Supabase keys here: they belong to the function (functions/.env).
# Production uses /api/join on the same domain (set by `bun run deploy`).
VITE_WAITLIST_API_URL=https://faas-blr1-xxxxxxxx.doserverless.co/api/v1/web/fn-xxxxxxxx/waitlist/join
# Local dev against `bun run dev:functions`:
# VITE_WAITLIST_API_URL=http://localhost:8787
