# Copy to functions/.env (never commit the real file). `bun run deploy:secrets` uploads it to
# Cloudflare; the DigitalOcean fallback reads it too.
# Supabase → Project Settings → API Keys. Use the SECRET key (sb_secret_…) or the legacy
# service_role key. It stays on the server; the browser never sees it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Comma-separated OTHER sites allowed to call the API (the live site itself is always allowed
# on Cloudflare). Empty = allow any origin.
ALLOWED_ORIGINS=https://your-site.example,http://localhost:8080
# Private data page (/admin): login checked on the server only. Password 12+ characters,
# session secret 32+ random characters (e.g. `openssl rand -hex 32`).
ADMIN_USERNAME=everloyal-admin
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_SESSION_SECRET=change-me-to-64-random-hex-characters
